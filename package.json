{
  "name": "local-first-online",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "wrangler dev --local",
    "lint": "eslint",
    "seo:check": "node scripts/seo-check.mjs",
    "test:redirect": "node --test scripts/canonical-redirect.test.mjs",
    "test:hosting": "node --test scripts/static-worker.test.mjs",
    "test:motion": "node --test scripts/video-scrubber.test.mjs scripts/scrub-media.test.mjs scripts/frame-sequence.test.mjs",
    "cf:build": "next build",
    "cf:preview": "npm run cf:build && wrangler dev --local",
    "cf:deploy": "npm run cf:build && wrangler deploy",
    "cf:upload": "npm run cf:build && wrangler versions upload"
  },
  "dependencies": {
    "gsap": "^3.15.0",
    "lucide-react": "^1.16.0",
    "next": "16.3.4",
    "react": "19.2.4",
    "react-dom": "19.2.4"
  },
  "devDependencies": {
    "@opennextjs/cloudflare": "1.20.6",
    "@tailwindcss/postcss": "^4",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "eslint": "^9",
    "eslint-config-next": "16.3.4",
    "playwright-core": "^1.63.0",
    "tailwindcss": "^4",
    "typescript": "^5",
    "wrangler": "4.131.0"
  }
}
